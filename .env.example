# Copy to .env (same folder) and fill in: cp .env.example .env   (./setup.sh on a laptop,
# scripts/vm_bootstrap.sh on the VM do this for you). .env is ignored by git and kept out of
# every Docker image. A variable exported in your shell wins. The `ares` CLI loads it itself;
# for bare docker compose or the selftests, load it into the shell first:
#   set -a; source .env; set +a
# It stays at the repo root on purpose: lab/ is bind-mounted into lab containers.
# Comments stay on their own line: Compose treats "KEY=   # text" as the value "# text".

# NVIDIA NIM key from build.nvidia.com. One key, two models:
#   agent under test  nvidia/nemotron-3.5-lightning-30b-a3b  (only the lab gateway container gets the key)
#   fix-PR text       nvidia/nemotron-3.5-super-vl-120b-a12b (ares drill --target / ares fix --open-pr)
NVIDIA_API_KEY=

# GitHub fine-grained token: your target repo only, Contents + Pull requests read/write
GITHUB_TOKEN=

# Gateway admin token. The VM bootstrap fills it (openssl rand -hex 16); the CLI has a lab default.
ARES_ADMIN_TOKEN=

# Sandbox runtime: empty = runc (Docker Desktop). The VM bootstrap sets runsc (gVisor).
ARES_SANDBOX_RUNTIME=
