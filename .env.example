# Copied to <repo>/.env by scripts/vm_bootstrap.sh (gitignored). The `ares` CLI loads it
# itself; for bare docker compose or the selftests, load it into the shell first:
#   set -a; source .env; set +a
# It stays at the repo root on purpose: lab/ is bind-mounted into lab containers.
# Comments stay on their own line: Compose treats "KEY=   # text" as the value "# text".

# Filled in by the bootstrap script (openssl rand -hex 16).
ARES_ADMIN_TOKEN=
# The only real model key; lives here and nowhere else.
NVIDIA_API_KEY=
# Optional: lets `ares fix --pr` open the GitHub pull request.
GITHUB_TOKEN=
# gVisor on the VM; unset or runc on Docker Desktop.
ARES_SANDBOX_RUNTIME=runsc
ARES_MODEL=nvidia/nemotron-3-super-120b-a12b
