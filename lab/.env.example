# Copied to lab/.env by scripts/vm_bootstrap.sh (gitignored). Compose reads it.
# Comments stay on their own line: Compose treats "KEY=   # text" as the value "# text".

# Filled in by the bootstrap script (openssl rand -hex 16).
ARES_ADMIN_TOKEN=
# The only real key; lives here and nowhere else.
NVIDIA_API_KEY=
# gVisor on the VM; unset or runc on Docker Desktop.
ARES_SANDBOX_RUNTIME=runsc
ARES_MODEL=nvidia/nemotron-3-super-120b-a12b
