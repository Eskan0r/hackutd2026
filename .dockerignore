# The gateway and sandbox images build from the repo root, so keep anything
# large or secret out of the build context.
.venv/
.git/
.github/
.idea/
__pycache__/
*.py[cod]
.pytest_cache/

# Run artifacts and anything that could hold a real key
.ares-demo/
.ares-livecheck/
lab/runs/
runs/
.env
*.env
ares.key
*.jsonl

# Not needed inside any image
tests/
scripts/
web/
docs/
ARCHITECTURE.md
CLAUDE.md
README.md
